{
    "compilerOptions": {
        "target": "es6",
        "lib": [
            "es6",
            "es2022"
        ],
        "module": "NodeNext",
        "esModuleInterop": true,
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist/esm",
    },
    "include": [
        "src/index.ts",
        "src/unmaker/unmaker.ts"
    ],
    "tsc-alias": {
        "resolveFullPaths": true,
        "resolveFullExtension": ".js",
    },
    "exclude": [
        "test/**",
        "src/**/tests/**",
        "src/**/*.test.ts",
        "src/**/*.test.js",
        "dist/**",
        "node_modules/**"
    ]
}